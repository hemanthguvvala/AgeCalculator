<?xml version="1.0" encoding="utf-8"?>
<!-- Cosmic icon background: deep night-sky gradient with a soft glow toward
     the center. The glow places the foreground sparkle in front of a halo
     so the icon reads as "a star in the cosmos" rather than "art on a
     swatch". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base radial gradient: violet-tinted center fading to deep navy. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="68">
                <item android:offset="0.0" android:color="#1F1A38" />
                <item android:offset="0.55" android:color="#0E0F22" />
                <item android:offset="1.0" android:color="#04050D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle warm halo behind the sparkle. -->
    <path
        android:pathData="M54,54 m-44,0 a44,44 0 1,0 88,0 a44,44 0 1,0 -88,0z"
        android:fillAlpha="0.20">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="40">
                <item android:offset="0.0" android:color="#FFE0C097" />
                <item android:offset="0.6" android:color="#33E0C097" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- A few faint background stars for cosmic depth. -->
    <path
        android:pathData="M22,28 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0z"
        android:fillColor="#88FFFFFF" />
    <path
        android:pathData="M86,30 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0z"
        android:fillColor="#66FFFFFF" />
    <path
        android:pathData="M28,82 m-0.8,0 a0.8,0.8 0 1,0 1.6,0 a0.8,0.8 0 1,0 -1.6,0z"
        android:fillColor="#55FFFFFF" />
    <path
        android:pathData="M82,80 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0z"
        android:fillColor="#77FFFFFF" />
    <path
        android:pathData="M16,58 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0z"
        android:fillColor="#44FFFFFF" />
    <path
        android:pathData="M92,62 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0z"
        android:fillColor="#44FFFFFF" />

</vector>
