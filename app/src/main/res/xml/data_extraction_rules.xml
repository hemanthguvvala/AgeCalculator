<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-Backup is fully off for this app. Birthdate, mood entries, and
  partner names are PII; they should never leave the device without explicit
  user opt-in (which we don't currently offer). For Android 12+ uses
  cloud-backup, for older versions falls back to device-transfer disable.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
