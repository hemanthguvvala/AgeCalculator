<?xml version="1.0" encoding="utf-8"?>
<!--
  FAN native ad layout. Hosted inside a GlassCard via AndroidView, so the
  outer chrome is provided by Compose and this layout is just the ad body.

  Required FAN view types (com.facebook.ads.MediaView, AdOptionsView) live in
  the View world, which is why this is XML rather than Compose.
-->
<com.facebook.ads.NativeAdLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fan_native_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Header row: icon + advertiser + sponsored badge + AdChoices -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.facebook.ads.MediaView
                android:id="@+id/fan_native_icon"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/fan_native_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/fan_native_sponsored"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:maxLines="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fan_native_choices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Main media — image or video. -->
        <com.facebook.ads.MediaView
            android:id="@+id/fan_native_media"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/fan_native_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:lineHeight="18sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <Button
            android:id="@+id/fan_native_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/native_cta_bg"
            android:textColor="#0B0E1F"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.facebook.ads.NativeAdLayout>
